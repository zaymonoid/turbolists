{
  "workspace": [
    "./packages/core",
    "./packages/app"
  ],
  "nodeModulesDir": "auto",
  "lock": false,
  "tasks": {
    "dev": "cd packages/app && deno task tauri dev",
    "dev:ios": "cd packages/app && deno task tauri ios dev",
    "test": "cd packages/core && deno test src/",
    "typecheck": "cd packages/core && deno check src/",
    "website": "deno run --allow-net --allow-read jsr:@std/http/file-server packages/website"
  }
}
